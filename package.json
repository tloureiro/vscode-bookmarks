{
  "name": "project-file-bookmarks",
  "displayName": "Project Bookmarks",
  "description": "Quick access to project files and folders in Explorer.",
  "version": "0.1.0",
  "publisher": "tloureiro",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/model.test.js",
    "test:integration": "npm run compile && node out/test/runIntegration.js",
    "package": "vsce package --allow-missing-repository --out project-file-bookmarks.vsix"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "projectBookmarks",
          "name": "Bookmarks",
          "icon": "resources/bookmark.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "projectBookmarks.add",
        "title": "Add Bookmark",
        "category": "Project Bookmarks",
        "icon": "$(add)"
      },
      {
        "command": "projectBookmarks.open",
        "title": "Open Bookmark",
        "category": "Project Bookmarks"
      },
      {
        "command": "projectBookmarks.rename",
        "title": "Rename Alias",
        "category": "Project Bookmarks",
        "icon": "$(edit)"
      },
      {
        "command": "projectBookmarks.remove",
        "title": "Remove Bookmark",
        "category": "Project Bookmarks",
        "icon": "$(close)"
      },
      {
        "command": "projectBookmarks.editConfig",
        "title": "Edit Bookmarks Configuration",
        "category": "Project Bookmarks",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "projectBookmarks.add",
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "group": "projectBookmarks"
        }
      ],
      "view/title": [
        {
          "command": "projectBookmarks.add",
          "when": "view == projectBookmarks",
          "group": "navigation"
        },
        {
          "command": "projectBookmarks.editConfig",
          "when": "view == projectBookmarks",
          "group": "configuration"
        }
      ],
      "view/item/context": [
        {
          "command": "projectBookmarks.rename",
          "when": "view == projectBookmarks && viewItem == bookmark",
          "group": "inline@1"
        },
        {
          "command": "projectBookmarks.remove",
          "when": "view == projectBookmarks && viewItem == bookmark",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "projectBookmarks.open",
          "when": "false"
        },
        {
          "command": "projectBookmarks.rename",
          "when": "false"
        },
        {
          "command": "projectBookmarks.remove",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectBookmarks",
        "contents": "Keep project files and folders close at hand.\n[Add Bookmark](command:projectBookmarks.add)\nOr right-click a file or folder in Explorer."
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "/.vscode/file-bookmarks.json",
        "url": "./schema/file-bookmarks.schema.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
